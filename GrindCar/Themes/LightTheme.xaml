<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ===== 亮色主题 (Light Theme) ===== -->

    <!-- 窗口/页面背景 -->
    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#F4F6F8" />
    <LinearGradientBrush x:Key="PageBackgroundBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#F4F6F8" Offset="0" />
        <GradientStop Color="#F8F9FA" Offset="0.55" />
        <GradientStop Color="#F0F2F4" Offset="1" />
    </LinearGradientBrush>

    <!-- 卡片/面板 -->
    <SolidColorBrush x:Key="CardBackgroundBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="CardBorderBrush" Color="#DCE3E8" />

    <!-- 输入控件背景 -->
    <SolidColorBrush x:Key="InputBackgroundBrush" Color="#F9FBFC" />

    <!-- 文字 -->
    <SolidColorBrush x:Key="PrimaryTextBrush" Color="#1E2A32" />
    <SolidColorBrush x:Key="SecondaryTextBrush" Color="#5B6B74" />
    <SolidColorBrush x:Key="MutedTextBrush" Color="#8B9AA6" />

    <!-- 主要操作按钮 -->
    <SolidColorBrush x:Key="PrimaryActionBrush" Color="#0F7A6C" />
    <SolidColorBrush x:Key="PrimaryActionHoverBrush" Color="#0B5F55" />
    <SolidColorBrush x:Key="PrimaryButtonForegroundBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="PrimaryButtonBorderBrush" Color="#0F7A6C" />

    <!-- 次要操作按钮 -->
    <SolidColorBrush x:Key="SecondaryActionBrush" Color="#EEF2F4" />
    <SolidColorBrush x:Key="SecondaryActionBorderBrush" Color="#D8E0E5" />
    <SolidColorBrush x:Key="SecondaryActionHoverBrush" Color="#E1E8EC" />

    <!-- 状态指示 -->
    <SolidColorBrush x:Key="StatusOnlineBrush" Color="#2EAC68" />
    <SolidColorBrush x:Key="StatusNeutralBrush" Color="#D98B22" />

    <!-- 顶栏状态徽章 -->
    <SolidColorBrush x:Key="StatusBadgeBackgroundBrush" Color="#E8F6F3" />
    <SolidColorBrush x:Key="StatusBadgeBorderBrush" Color="#B8DED4" />
    <SolidColorBrush x:Key="TimestampBackgroundBrush" Color="#EEF2F4" />

    <!-- 底部状态栏 -->
    <SolidColorBrush x:Key="StatusBarBackgroundBrush" Color="#EEF2F4" />
    <SolidColorBrush x:Key="StatusBarBorderBrush" Color="#DCE3E8" />

    <!-- 强调色（语义色，跨主题保持相近色相） -->
    <SolidColorBrush x:Key="AccentBrush" Color="#0F7A6C" />
    <SolidColorBrush x:Key="AccentSoftBrush" Color="#E8F6F3" />

    <!-- 分割线 -->
    <SolidColorBrush x:Key="LineBrush" Color="#E1E6EA" />

    <!-- DataGrid -->
    <SolidColorBrush x:Key="DataGridBackgroundBrush" Color="#FAFBFC" />
    <SolidColorBrush x:Key="DataGridAltRowBrush" Color="#F2F5F7" />
    <SolidColorBrush x:Key="DataGridHeaderBackgroundBrush" Color="#EEF2F4" />

    <!-- 绘图画布 -->
    <SolidColorBrush x:Key="CanvasBackgroundBrush" Color="#FCFDFD" />
    <SolidColorBrush x:Key="CanvasAxisBrush" Color="#B9C6CE" />

    <!-- Toggle Switch 控件专用 -->
    <SolidColorBrush x:Key="ToggleTrackOffBrush" Color="#D8E0E5" />
    <SolidColorBrush x:Key="ToggleTrackOffBorderBrush" Color="#C4CED6" />
    <SolidColorBrush x:Key="ToggleThumbBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="ToggleThumbBorderBrush" Color="#B6C0C8" />
    <SolidColorBrush x:Key="ToggleTrackHoverBorderBrush" Color="#0B5F55" />

    <!-- ===== 语义色（暗色/亮色主题通用，保持色相一致） ===== -->
    <SolidColorBrush x:Key="StandardBrush" Color="#D96C06" />
    <SolidColorBrush x:Key="LeftBrush" Color="#1769AA" />
    <SolidColorBrush x:Key="RightBrush" Color="#0F7A6C" />
    <SolidColorBrush x:Key="RepresentativeBrush" Color="#0F7A6C" />
    <SolidColorBrush x:Key="PointBrush" Color="#125A51" />

</ResourceDictionary>
