<Window x:Class="GrindCar.Views.PointCloudExportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:pointCloudModels="clr-namespace:GrindCar.Models.PointCloud"
        Title="点云导出"
        Width="760"
        Height="320"
        WindowStartupLocation="CenterOwner"
        Background="#F4F6F8">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock FontSize="22"
                   FontWeight="SemiBold"
                   Foreground="#1E2A32"
                   Text="点云导出" />
        

        <Grid Grid.Row="2" Margin="0,22,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="120" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="110" />
            </Grid.ColumnDefinitions>

            <TextBlock VerticalAlignment="Center"
                       Foreground="#1E2A32"
                       Text="设备列表" />

            <ComboBox x:Name="DeviceComboBox"
                      Grid.Column="1"
                      Height="32"
                      Margin="0,0,12,0"
                      IsEnabled="{Binding CanInteract}"
                      ItemsSource="{Binding Devices}"
                      SelectedItem="{Binding SelectedDevice}"
                      DisplayMemberPath="DisplayName" />

            <Button Grid.Column="2"
                    Height="32"
                    IsEnabled="{Binding CanInteract}"
                    Content="刷新设备"
                    Click="RefreshDevices_Click" />
        </Grid>

        <Grid Grid.Row="3" Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="120" />
                <ColumnDefinition Width="180" />
                <ColumnDefinition Width="120" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <TextBlock VerticalAlignment="Center"
                       Foreground="#1E2A32"
                       Text="导出格式" />

            <ComboBox x:Name="FormatComboBox"
                      Grid.Column="1"
                      Height="32"
                      IsEnabled="{Binding CanInteract}"
                      SelectedValuePath="Tag"
                      SelectedValue="{Binding SelectedExportFormat}"
                      SelectedIndex="0">
                <ComboBoxItem Content="PLY"
                              Tag="{x:Static pointCloudModels:PointCloudExportFormat.Ply}" />
                <ComboBoxItem Content="CSV"
                              Tag="{x:Static pointCloudModels:PointCloudExportFormat.Csv}" />
                <ComboBoxItem Content="OBJ"
                              Tag="{x:Static pointCloudModels:PointCloudExportFormat.Obj}" />
            </ComboBox>

            <TextBlock Grid.Column="2"
                       VerticalAlignment="Center"
                       Foreground="#1E2A32"
                       Text="保存路径" />

            <Grid Grid.Column="3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="110" />
                </Grid.ColumnDefinitions>

                <TextBox x:Name="OutputPathTextBox"
                         Height="32"
                         VerticalContentAlignment="Center"
                         IsEnabled="{Binding CanInteract}"
                         IsReadOnly="True"
                         Background="#FFFFFF"
                         Text="{Binding OutputPath, Mode=OneWay}" />

                <Button Grid.Column="1"
                        Margin="12,0,0,0"
                        Height="32"
                        IsEnabled="{Binding CanInteract}"
                        Content="选择路径"
                        Click="ChooseOutputPath_Click" />
            </Grid>
        </Grid>

        <Border Grid.Row="4"
                Margin="0,18,0,0"
                Padding="14"
                CornerRadius="10"
                BorderBrush="#D8E0E5"
                BorderThickness="1"
                Background="#FFFFFF">
            <TextBlock x:Name="StatusTextBlock"
                       Foreground="#4C5B65"
                       TextWrapping="Wrap"
                       Text="{Binding StatusText}"/>
        </Border>

        <StackPanel Grid.Row="5"
                    Margin="0,18,0,0"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right">
            <Button Width="96"
                    Height="34"
                    Margin="0,0,10,0"
                    Content="关闭"
                    Click="Close_Click" />
            <Button x:Name="ExportButton"
                    Width="120"
                    Height="34"
                    IsEnabled="{Binding CanInteract}"
                    Content="开始导出"
                    Click="Export_Click" />
        </StackPanel>
    </Grid>
</Window>
