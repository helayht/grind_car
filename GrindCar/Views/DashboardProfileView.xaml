<UserControl x:Class="GrindCar.Views.DashboardProfileView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Loaded="View_Loaded" DataContextChanged="View_DataContextChanged">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <WrapPanel Margin="0,0,0,3">
            <TextBlock Text="{Binding MetadataText}" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="12" Margin="0,0,14,0" />
            <TextBlock Text="━ 实测代表廓形" Foreground="{DynamicResource RepresentativeBrush}" FontSize="12" Margin="0,0,12,0" />
            <TextBlock Text="━ 标准廓形" Foreground="{DynamicResource StandardBrush}" FontSize="12" />
        </WrapPanel>
        <Border Grid.Row="1" Background="{DynamicResource CanvasBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="6">
            <Grid>
                <Canvas x:Name="PlotCanvas" ClipToBounds="True" SizeChanged="PlotCanvas_SizeChanged">
                    <Path Data="{Binding GridGeometry}" Stroke="{DynamicResource CardBorderBrush}" StrokeThickness="1" />
                    <Path Data="{Binding Plot.StandardCurveGeometry}" Stroke="{DynamicResource StandardBrush}" StrokeThickness="2.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                    <Path Data="{Binding Plot.RepresentativeCurveGeometry}" Stroke="{DynamicResource RepresentativeBrush}" StrokeThickness="3" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                    <ItemsControl ItemsSource="{Binding AxisLabels}">
                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><Canvas /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                        <ItemsControl.ItemContainerStyle>
                            <Style TargetType="ContentPresenter">
                                <Setter Property="Canvas.Left" Value="{Binding Left}" />
                                <Setter Property="Canvas.Top" Value="{Binding Top}" />
                            </Style>
                        </ItemsControl.ItemContainerStyle>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate><TextBlock Width="{Binding Width}" Text="{Binding Text}" TextAlignment="Center" FontSize="10" Foreground="{DynamicResource SecondaryTextBrush}" /></DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Canvas>
                <TextBlock Text="高度 (mm)" FontSize="10" Foreground="{DynamicResource SecondaryTextBrush}" Margin="8,4" HorizontalAlignment="Left" VerticalAlignment="Top" />
                <TextBlock Text="横向位置 (mm)" FontSize="10" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,0,2" HorizontalAlignment="Center" VerticalAlignment="Bottom" />
                <TextBlock Text="{Binding EmptyText}" Visibility="{Binding EmptyVisibility}" Foreground="{DynamicResource SecondaryTextBrush}" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,4,8,0" FontSize="11" />
            </Grid>
        </Border>
        <TextBlock Grid.Row="2" Text="{Binding StatusText}" ToolTip="{Binding StatusText}" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="11" Margin="0,4,0,0" />
    </Grid>
</UserControl>
