<Window x:Class="GrindCar.Views.CurveRotationDebugWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="曲线旋转调试"
        Width="1280"
        Height="820"
        MinWidth="1080"
        MinHeight="700"
        WindowStartupLocation="CenterOwner"
        Background="#F4F6F8">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Padding="18"
                Background="#FFFFFF"
                BorderBrush="#DCE3E8"
                BorderThickness="1"
                CornerRadius="12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <TextBlock FontSize="24"
                               FontWeight="SemiBold"
                               Foreground="#1E2A32"
                               Text="曲线旋转角度调试" />
                    <TextBlock Margin="0,6,0,0"
                               Foreground="#61727D"
                               Text="导入 CSV(x,y)，输入角度后按原点逆时针旋转，叠加对比原始曲线和旋转曲线。" />
                </StackPanel>

                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <Button Width="128"
                            Height="34"
                            Margin="0,0,10,0"
                            Content="导入 CSV"
                            Click="ImportCsv_Click" />
                    <Button Width="88"
                            Height="34"
                            Content="关闭"
                            Click="Close_Click" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="0,14,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.5*" />
                <ColumnDefinition Width="0.9*" />
                <ColumnDefinition Width="0.7*" />
                <ColumnDefinition Width="0.7*" />
                <ColumnDefinition Width="0.8*" />
                <ColumnDefinition Width="0.8*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Margin="0,0,12,0"
                    Padding="14"
                    Background="#FFFFFF"
                    BorderBrush="#DCE3E8"
                    BorderThickness="1"
                    CornerRadius="10">
                <StackPanel>
                    <TextBlock Foreground="#61727D" Text="当前文件" />
                    <TextBlock x:Name="FilePathTextBlock"
                               Margin="0,8,0,0"
                               FontWeight="SemiBold"
                               Foreground="#1E2A32"
                               Text="未导入文件"
                               TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </Border>

            <Border Grid.Column="1"
                    Margin="0,0,12,0"
                    Padding="14"
                    Background="#FFFFFF"
                    BorderBrush="#DCE3E8"
                    BorderThickness="1"
                    CornerRadius="10">
                <StackPanel>
                    <TextBlock Foreground="#61727D" Text="旋转角度 (°)" />
                    <TextBox x:Name="AngleTextBox"
                             Height="30"
                             Margin="0,8,0,0"
                             VerticalContentAlignment="Center"
                             Text="0" />
                </StackPanel>
            </Border>

            <Border Grid.Column="2"
                    Margin="0,0,12,0"
                    Padding="14"
                    Background="#FFFFFF"
                    BorderBrush="#DCE3E8"
                    BorderThickness="1"
                    CornerRadius="10">
                <StackPanel>
                    <TextBlock Foreground="#61727D" Text="点数量" />
                    <TextBlock x:Name="PointCountTextBlock"
                               Margin="0,8,0,0"
                               FontSize="22"
                               FontWeight="SemiBold"
                               Foreground="#0F7A6C"
                               Text="0" />
                </StackPanel>
            </Border>

            <Border Grid.Column="3"
                    Margin="0,0,12,0"
                    Padding="14"
                    Background="#FFFFFF"
                    BorderBrush="#DCE3E8"
                    BorderThickness="1"
                    CornerRadius="10">
                <StackPanel>
                    <TextBlock Foreground="#61727D" Text="X 范围" />
                    <TextBlock x:Name="XRangeTextBlock"
                               Margin="0,8,0,0"
                               FontWeight="SemiBold"
                               Foreground="#1E2A32"
                               Text="-" />
                </StackPanel>
            </Border>

            <Border Grid.Column="4"
                    Margin="0,0,12,0"
                    Padding="14"
                    Background="#FFFFFF"
                    BorderBrush="#DCE3E8"
                    BorderThickness="1"
                    CornerRadius="10">
                <StackPanel>
                    <TextBlock Foreground="#61727D" Text="Y 范围" />
                    <TextBlock x:Name="YRangeTextBlock"
                               Margin="0,8,0,0"
                               FontWeight="SemiBold"
                               Foreground="#1E2A32"
                               Text="-" />
                </StackPanel>
            </Border>

            <Border Grid.Column="5"
                    Margin="0,0,12,0"
                    Padding="14"
                    Background="#FFFFFF"
                    BorderBrush="#DCE3E8"
                    BorderThickness="1"
                    CornerRadius="10">
                <StackPanel>
                    <TextBlock Foreground="#61727D" Text="旋转后 Y 范围" />
                    <TextBlock x:Name="RotatedYRangeTextBlock"
                               Margin="0,8,0,0"
                               FontWeight="SemiBold"
                               Foreground="#1E2A32"
                               Text="-" />
                </StackPanel>
            </Border>

            <StackPanel Grid.Column="6"
                        Orientation="Horizontal"
                        VerticalAlignment="Center">
                <Button x:Name="RotateButton"
                        Width="128"
                        Height="34"
                        Content="应用旋转"
                        Click="ApplyRotation_Click"
                        IsEnabled="False" />
            </StackPanel>
        </Grid>

        <Border Grid.Row="2"
                Padding="16"
                Background="#FFFFFF"
                BorderBrush="#DCE3E8"
                BorderThickness="1"
                CornerRadius="12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <DockPanel LastChildFill="False">
                    <TextBlock FontSize="19"
                               FontWeight="SemiBold"
                               Foreground="#1E2A32"
                               Text="坐标曲线" />
                </DockPanel>

                <Border Grid.Row="1"
                        Margin="0,14,0,0"
                        Background="#FBFCFD"
                        BorderBrush="#E1E8EE"
                        BorderThickness="1"
                        CornerRadius="8">
                    <Canvas x:Name="PlotCanvas"
                            SizeChanged="PlotCanvas_SizeChanged" />
                </Border>
            </Grid>
        </Border>

        <Border Grid.Row="3"
                Margin="0,14,0,0"
                Padding="14"
                Background="#FFFFFF"
                BorderBrush="#DCE3E8"
                BorderThickness="1"
                CornerRadius="10">
            <TextBlock x:Name="StatusTextBlock"
                       Foreground="#61727D"
                       TextWrapping="Wrap"
                       Text="请先导入 CSV(x,y) 数据。" />
        </Border>
    </Grid>
</Window>
