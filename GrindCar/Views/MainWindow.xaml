<Window x:Class="GrindCar.Views.MainWindow"
        x:Name="MainWindowRoot"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="轨面打磨驾驶舱"
        Width="1440"
        Height="900"
        MinWidth="1200"
        MinHeight="760"
        WindowStartupLocation="CenterScreen"
        Background="#0B1118">
    <Window.Resources>
        <LinearGradientBrush x:Key="PageBackgroundBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#0B1118" Offset="0" />
            <GradientStop Color="#0F1823" Offset="0.55" />
            <GradientStop Color="#0A121B" Offset="1" />
        </LinearGradientBrush>

        <SolidColorBrush x:Key="CardBackgroundBrush" Color="#121B27" />
        <SolidColorBrush x:Key="CardBorderBrush" Color="#2A384A" />
        <SolidColorBrush x:Key="PrimaryTextBrush" Color="#E8EEF5" />
        <SolidColorBrush x:Key="SecondaryTextBrush" Color="#AAB8C7" />
        <SolidColorBrush x:Key="MutedTextBrush" Color="#7E8EA0" />
        <SolidColorBrush x:Key="PrimaryActionBrush" Color="#2B4F73" />
        <SolidColorBrush x:Key="PrimaryActionHoverBrush" Color="#37638D" />
        <SolidColorBrush x:Key="SecondaryActionBrush" Color="#1A2736" />
        <SolidColorBrush x:Key="SecondaryActionBorderBrush" Color="#33475C" />
        <SolidColorBrush x:Key="StatusOnlineBrush" Color="#5BD49A" />
        <SolidColorBrush x:Key="StatusNeutralBrush" Color="#E1B86A" />

        <Style x:Key="PanelCardStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource CardBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource CardBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="20" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
        </Style>

        <Style x:Key="PageTitleStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Bahnschrift" />
            <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="22" />
        </Style>

        <Style x:Key="SectionTitleStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Bahnschrift" />
            <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="17" />
        </Style>

        <Style x:Key="CaptionStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource SecondaryTextBrush}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontFamily" Value="Microsoft YaHei UI" />
        </Style>

        <Style x:Key="ValueStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}" />
            <Setter Property="FontFamily" Value="Consolas" />
            <Setter Property="FontSize" Value="42" />
            <Setter Property="FontWeight" Value="Bold" />
        </Style>

        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="Background" Value="{StaticResource PrimaryActionBrush}" />
            <Setter Property="BorderBrush" Value="#4F6982" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="14,8" />
            <Setter Property="MinHeight" Value="34" />
            <Setter Property="FontFamily" Value="Microsoft YaHei UI" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              RecognizesAccessKey="True" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource PrimaryActionHoverBrush}" />
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.55" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SecondaryButtonStyle" TargetType="Button" BasedOn="{StaticResource PrimaryButtonStyle}">
            <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}" />
            <Setter Property="Background" Value="{StaticResource SecondaryActionBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource SecondaryActionBorderBrush}" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#223244" />
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.55" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Background="{StaticResource PageBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="20,16,20,12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Style="{StaticResource PanelCardStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <DockPanel Grid.Row="0" LastChildFill="False">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Margin="0,0,10,0"
                                    Padding="10,6"
                                    CornerRadius="6"
                                    Background="#152A1F"
                                    BorderBrush="#295640"
                                    BorderThickness="1">
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Width="8" Height="8" Fill="{StaticResource StatusOnlineBrush}" VerticalAlignment="Center" />
                                    <TextBlock Margin="7,0,0,0"
                                               VerticalAlignment="Center"
                                               Foreground="{StaticResource PrimaryTextBrush}"
                                               Text="{Binding ElementName=MainWindowRoot, Path=Measurement.PlcConnectionStatus}" />
                                </StackPanel>
                            </Border>

                            <Border Padding="10,6"
                                    CornerRadius="6"
                                    Background="#172433"
                                    BorderBrush="{StaticResource CardBorderBrush}"
                                    BorderThickness="1">
                                <TextBlock Foreground="{StaticResource SecondaryTextBrush}"
                                           FontFamily="Consolas"
                                           Text="{Binding DashboardTimestamp}" />
                            </Border>
                        </StackPanel>
                    </DockPanel>

                    <WrapPanel Grid.Row="1"
                               Margin="0,14,0,0"
                               ItemHeight="46"
                               ItemWidth="140"
                               Orientation="Horizontal">
                        <Button Style="{StaticResource SecondaryButtonStyle}"
                                Margin="0,0,8,8"
                                Content="PLC连接"
                                IsEnabled="{Binding ElementName=MainWindowRoot, Path=Measurement.CanOperate}"
                                Click="OpenPlcConnectionSettings_Click" />
                        <Button Style="{StaticResource SecondaryButtonStyle}"
                                Margin="0,0,8,8"
                                Content="点云导出"
                                Click="OpenPointCloudExportWindow_Click" />
                        <Button Style="{StaticResource SecondaryButtonStyle}"
                                Margin="0,0,8,8"
                                Content="打磨深度调试"
                                Click="OpenGrindDepthDebugWindow_Click" />
                        <Button Style="{StaticResource SecondaryButtonStyle}"
                                Margin="0,0,8,8"
                                Content="点云算法验证"
                                Click="OpenPointCloudGrindDepthDebugWindow_Click" />
                        <Button Style="{StaticResource SecondaryButtonStyle}"
                                Margin="0,0,8,8"
                                Content="电机调试"
                                Click="OpenMotorDebugWindow_Click" />
                    </WrapPanel>
                </Grid>
            </Border>

            <Grid Grid.Row="1" Margin="0,12,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource PanelCardStyle}" Margin="0,0,8,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <TextBlock Text="电源状态" Style="{StaticResource SectionTitleStyle}" />
                        <StackPanel Grid.Row="2" Margin="0,16,0,0">
                            <TextBlock Text="{Binding BatteryLevelText}" Style="{StaticResource ValueStyle}" />
                            <TextBlock Margin="0,4,0,0" Text="{Binding BatteryStateText}" Foreground="{StaticResource MutedTextBrush}" />
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Grid.Column="1" Style="{StaticResource PanelCardStyle}" Margin="8,0,0,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <TextBlock Text="速度状态" Style="{StaticResource SectionTitleStyle}" />
                        <StackPanel Grid.Row="2" Margin="0,16,0,0">
                            <TextBlock Text="{Binding CurrentSpeedText}" Style="{StaticResource ValueStyle}" />
                            <TextBlock Margin="0,4,0,0" Text="{Binding SpeedStatus}" Foreground="{StaticResource MutedTextBrush}" />
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>

            <Border Grid.Row="2"
                    Margin="0,12,0,0"
                    Style="{StaticResource PanelCardStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1*" />
                        <ColumnDefinition Width="1*" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Row="0"
                               Grid.ColumnSpan="2"
                               Text="测量参数配置"
                               Style="{StaticResource SectionTitleStyle}" />

                    <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,14,12,0">
                        <TextBlock Text="测量起点位置" Style="{StaticResource CaptionStyle}" />
                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="MeasurementStartPositionTextBox"
                                     Height="34"
                                     Padding="8,4"
                                     VerticalContentAlignment="Center"
                                     Foreground="{StaticResource PrimaryTextBrush}"
                                     Background="#0F1722"
                                     BorderBrush="{StaticResource CardBorderBrush}"
                                     IsEnabled="{Binding ElementName=MainWindowRoot, Path=Measurement.CanOperate}"
                                     Text="{Binding ElementName=MainWindowRoot, Path=Measurement.StartPositionText, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Grid.Column="1"
                                       Margin="8,0,0,0"
                                       VerticalAlignment="Center"
                                       Foreground="{StaticResource SecondaryTextBrush}"
                                       Text="m" />
                        </Grid>
                    </StackPanel>

                    <StackPanel Grid.Row="1" Grid.Column="1" Margin="12,14,0,0">
                        <TextBlock Text="测量终点位置" Style="{StaticResource CaptionStyle}" />
                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="MeasurementEndPositionTextBox"
                                     Height="34"
                                     Padding="8,4"
                                     VerticalContentAlignment="Center"
                                     Foreground="{StaticResource PrimaryTextBrush}"
                                     Background="#0F1722"
                                     BorderBrush="{StaticResource CardBorderBrush}"
                                     IsEnabled="{Binding ElementName=MainWindowRoot, Path=Measurement.CanOperate}"
                                     Text="{Binding ElementName=MainWindowRoot, Path=Measurement.EndPositionText, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Grid.Column="1"
                                       Margin="8,0,0,0"
                                       VerticalAlignment="Center"
                                       Foreground="{StaticResource SecondaryTextBrush}"
                                       Text="m" />
                        </Grid>
                    </StackPanel>

                    <StackPanel Grid.Row="2" Grid.Column="0" Margin="0,14,12,0">
                        <TextBlock Text="打磨起点位置" Style="{StaticResource CaptionStyle}" />
                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="GrindingStartPositionTextBox"
                                     Height="34"
                                     Padding="8,4"
                                     VerticalContentAlignment="Center"
                                     Foreground="{StaticResource PrimaryTextBrush}"
                                     Background="#0F1722"
                                     BorderBrush="{StaticResource CardBorderBrush}"
                                     IsEnabled="{Binding ElementName=MainWindowRoot, Path=Measurement.CanOperate}"
                                     Text="{Binding ElementName=MainWindowRoot, Path=Measurement.GrindingStartPositionText, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Grid.Column="1"
                                       Margin="8,0,0,0"
                                       VerticalAlignment="Center"
                                       Foreground="{StaticResource SecondaryTextBrush}"
                                       Text="m" />
                        </Grid>
                    </StackPanel>

                    <StackPanel Grid.Row="2" Grid.Column="1" Margin="12,14,0,0">
                        <TextBlock Text="打磨终点位置" Style="{StaticResource CaptionStyle}" />
                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="GrindingEndPositionTextBox"
                                     Height="34"
                                     Padding="8,4"
                                     VerticalContentAlignment="Center"
                                     Foreground="{StaticResource PrimaryTextBrush}"
                                     Background="#0F1722"
                                     BorderBrush="{StaticResource CardBorderBrush}"
                                     IsEnabled="{Binding ElementName=MainWindowRoot, Path=Measurement.CanOperate}"
                                     Text="{Binding ElementName=MainWindowRoot, Path=Measurement.GrindingEndPositionText, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Grid.Column="1"
                                       Margin="8,0,0,0"
                                       VerticalAlignment="Center"
                                       Foreground="{StaticResource SecondaryTextBrush}"
                                       Text="m" />
                        </Grid>
                    </StackPanel>

                    <StackPanel Grid.Row="3" Grid.Column="0" Margin="0,14,12,0">
                        <TextBlock Text="小车运行速度" Style="{StaticResource CaptionStyle}" />
                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="CarSpeedTextBox"
                                     Height="34"
                                     Padding="8,4"
                                     VerticalContentAlignment="Center"
                                     Foreground="{StaticResource PrimaryTextBrush}"
                                     Background="#0F1722"
                                     BorderBrush="{StaticResource CardBorderBrush}"
                                     IsEnabled="{Binding ElementName=MainWindowRoot, Path=Measurement.CanOperate}"
                                     Text="{Binding ElementName=MainWindowRoot, Path=Measurement.CarSpeedText, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Grid.Column="1"
                                       Margin="8,0,0,0"
                                       VerticalAlignment="Center"
                                       Foreground="{StaticResource SecondaryTextBrush}"
                                       Text="m/min" />
                        </Grid>
                    </StackPanel>

                    <Grid Grid.Row="3" Grid.Column="1" Margin="12,14,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Margin="0,0,12,0">
                            <TextBlock Text="单次测量总条数" Style="{StaticResource CaptionStyle}" />
                            <Grid Margin="0,8,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="ProfileCountTextBox"
                                         Height="34"
                                         Padding="8,4"
                                         VerticalContentAlignment="Center"
                                         Foreground="{StaticResource PrimaryTextBrush}"
                                         Background="#0F1722"
                                         BorderBrush="{StaticResource CardBorderBrush}"
                                         IsEnabled="{Binding ElementName=MainWindowRoot, Path=Measurement.CanOperate}"
                                         Text="{Binding ElementName=MainWindowRoot, Path=Measurement.ProfileCountText, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBlock Grid.Column="1"
                                           Margin="8,0,0,0"
                                           VerticalAlignment="Center"
                                           Foreground="{StaticResource SecondaryTextBrush}"
                                           Text="条" />
                            </Grid>
                        </StackPanel>

                        <StackPanel Grid.Column="1">
                            <TextBlock Text="计算帧率" Style="{StaticResource CaptionStyle}" />
                            <Border Margin="0,8,0,0"
                                    Height="34"
                                    Padding="8,4"
                                    Background="#0F1722"
                                    BorderBrush="{StaticResource CardBorderBrush}"
                                    BorderThickness="1">
                                <TextBlock VerticalAlignment="Center"
                                           Foreground="{StaticResource PrimaryTextBrush}"
                                           FontFamily="Consolas"
                                           Text="{Binding ElementName=MainWindowRoot, Path=Measurement.CalculatedFrameRateText}" />
                            </Border>
                        </StackPanel>
                    </Grid>

                    <StackPanel Grid.Row="4"
                                Grid.ColumnSpan="2"
                                Margin="0,16,0,0">
                        <StackPanel Orientation="Horizontal">
                            <Button x:Name="WriteMeasurementParametersButton"
                                    MinWidth="180"
                                    Style="{StaticResource PrimaryButtonStyle}"
                                    IsEnabled="{Binding ElementName=MainWindowRoot, Path=Measurement.CanOperate}"
                                    Content="写入测量起止点"
                                    Click="WriteMeasurementParameters_Click" />
                            <Button x:Name="WriteGrindingParametersButton"
                                    Margin="10,0,0,0"
                                    MinWidth="180"
                                    Style="{StaticResource PrimaryButtonStyle}"
                                    IsEnabled="{Binding ElementName=MainWindowRoot, Path=Measurement.CanOperate}"
                                    Content="写入打磨起止点"
                                    Click="WriteGrindingParameters_Click" />
                            <Button x:Name="SavePointCloudCaptureSettingsButton"
                                    Margin="10,0,0,0"
                                    MinWidth="180"
                                    Style="{StaticResource PrimaryButtonStyle}"
                                    IsEnabled="{Binding ElementName=MainWindowRoot, Path=Measurement.CanOperate}"
                                    Content="保存点云采集参数"
                                    Click="SavePointCloudCaptureSettings_Click" />
                            <Button x:Name="StartMeasurementMotionButton"
                                    Margin="10,0,0,0"
                                    MinWidth="180"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    IsEnabled="{Binding ElementName=MainWindowRoot, Path=Measurement.CanOperate}"
                                    Content="测量运动启动"
                                    Click="StartMeasurementMotion_Click" />
                            <Button x:Name="StartGrindingMotionButton"
                                    Margin="10,0,0,0"
                                    MinWidth="180"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    IsEnabled="{Binding ElementName=MainWindowRoot, Path=Measurement.CanOperate}"
                                    Content="打磨运动启动"
                                    Click="StartGrindingMotion_Click" />
                        </StackPanel>
                        <Border Margin="0,10,0,0"
                                Padding="10,8"
                                CornerRadius="6"
                                Background="#0F1722"
                                BorderBrush="{StaticResource CardBorderBrush}"
                                BorderThickness="1">
                            <TextBlock x:Name="MeasurementParameterStatusTextBlock"
                                       Foreground="{StaticResource SecondaryTextBrush}"
                                       Text="{Binding ElementName=MainWindowRoot, Path=Measurement.StatusMessage}"
                                       TextWrapping="Wrap" />
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <Border Grid.Row="1"
                Margin="20,0,20,16"
                Padding="10,8"
                CornerRadius="6"
                Background="#111A26"
                BorderBrush="#2A3A4D"
                BorderThickness="1">
            <!-- <TextBlock Foreground="{StaticResource SecondaryTextBrush}" -->
            <!--            Text="提示：如需接入实时速度/电量，请先在 PLC 协议中补充对应只读地址并同步到参数定义。" -->
            <!--            TextWrapping="Wrap" /> -->
        </Border>
    </Grid>
</Window>
