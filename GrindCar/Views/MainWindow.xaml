<Window x:Class="GrindCar.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="轨面打磨驾驶舱"
        Width="1440"
        Height="900"
        MinWidth="1200"
        MinHeight="760"
        WindowStartupLocation="CenterScreen"
        Background="#07111E">
    <Window.Resources>  
        <LinearGradientBrush x:Key="WindowBackground" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#08111D" Offset="0" />
            <GradientStop Color="#0B1B2D" Offset="0.55" />
            <GradientStop Color="#081625" Offset="1" />
        </LinearGradientBrush>
        <RadialGradientBrush x:Key="GlowPanelBackground" Center="0.5,0.25" RadiusX="1.1" RadiusY="0.95">
            <GradientStop Color="#132742" Offset="0" />
            <GradientStop Color="#0F1F33" Offset="0.38" />
            <GradientStop Color="#0A1727" Offset="1" />
        </RadialGradientBrush>
        <LinearGradientBrush x:Key="MetricGlow" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#7DF0BE" Offset="0" />
            <GradientStop Color="#47D3A7" Offset="0.55" />
            <GradientStop Color="#39A7D8" Offset="1" />
        </LinearGradientBrush>

        <SolidColorBrush x:Key="PanelBorder" Color="#2C4461" /> 
        <SolidColorBrush x:Key="SubtlePanelBackground" Color="#0C1726" />
        <SolidColorBrush x:Key="PrimaryText" Color="#F4F7FB" />
        <SolidColorBrush x:Key="SecondaryText" Color="#8EA7C2" />
        <SolidColorBrush x:Key="AccentTeal" Color="#5AD7A0" />

        <Style x:Key="PanelCard" TargetType="Border">   
            <Setter Property="Background" Value="{StaticResource GlowPanelBackground}" />
            <Setter Property="BorderBrush" Value="{StaticResource PanelBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="24" />
            <Setter Property="Padding" Value="24" />
        </Style>

        <Style x:Key="DashboardTitle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource PrimaryText}" />
            <Setter Property="FontFamily" Value="Microsoft YaHei UI" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
    </Window.Resources>

    <Grid Background="{StaticResource WindowBackground}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="1.2*" />
            <RowDefinition Height="0.48*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Margin="24,20,24,16"
                Padding="18,14"
                CornerRadius="22"
                Background="#0B1828"
                BorderBrush="#263B56"
                BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="点云导出"
                            Margin="0,0,12,0"
                            Padding="18,10"
                            Background="#17304A"
                            BorderBrush="#285377"
                            Foreground="{StaticResource PrimaryText}"
                            Click="OpenPointCloudExportWindow_Click" />

                    <Button Content="中位截面调试"
                            Margin="0,0,12,0"
                            Padding="18,10"
                            Background="#17304A"
                            BorderBrush="#285377"
                            Foreground="{StaticResource PrimaryText}"
                            Click="OpenMedianSectionDebugWindow_Click" />

                    <Button Content="曲线旋转调试"
                            Margin="0,0,12,0"
                            Padding="18,10"
                            Background="#17304A"
                            BorderBrush="#285377"
                            Foreground="{StaticResource PrimaryText}"
                            Click="OpenCurveRotationDebugWindow_Click" />

                    <Button Content="打磨深度调试"
                            Margin="0,0,12,0"
                            Padding="18,10"
                            Background="#17304A"
                            BorderBrush="#285377"
                            Foreground="{StaticResource PrimaryText}"
                            Click="OpenGrindDepthDebugWindow_Click" />

                    <Button Content="电机调试"
                            Margin="0,0,12,0"
                            Padding="18,10"
                            Background="#17304A"
                            BorderBrush="#285377"
                            Foreground="{StaticResource PrimaryText}"
                            Click="OpenMotorDebugWindow_Click" />

                    <Border Margin="0,0,12,0"
                            Padding="14,8"
                            CornerRadius="18"
                            Background="#11243A"
                            BorderBrush="#234A6F"
                            BorderThickness="1">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="10" Height="10" Fill="{StaticResource AccentTeal}" VerticalAlignment="Center" />
                            <TextBlock Margin="8,0,0,0"
                                       Foreground="{StaticResource PrimaryText}"
                                       Text="{Binding ConnectionStatus}" />
                        </StackPanel>
                    </Border>

                    <Border Padding="14,8"
                            CornerRadius="18"
                            Background="#11243A"
                            BorderBrush="#234A6F"
                            BorderThickness="1">
                        <TextBlock Foreground="{StaticResource PrimaryText}"
                                   Text="{Binding DashboardTimestamp}" />
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="24,0,24,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource PanelCard}" Margin="0,0,12,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Canvas IsHitTestVisible="False">
                        <Ellipse Width="220" Height="220" Fill="#1A3352" Opacity="0.16" Canvas.Left="-70" Canvas.Top="118" />
                        <Ellipse Width="140" Height="140" Fill="#225C72" Opacity="0.10" Canvas.Left="410" Canvas.Top="-28" />
                    </Canvas>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel>
                            <TextBlock Text="电源监控"
                                       Style="{StaticResource DashboardTitle}"
                                       FontSize="24" />
                        </StackPanel>

                        <Border Grid.Column="1"
                                Padding="12,6"
                                CornerRadius="14"
                                BorderBrush="#29445E"
                                BorderThickness="1"
                                Background="#132033">
                            <TextBlock Foreground="{Binding BatteryAccentColor}"
                                       FontWeight="SemiBold"
                                       Text="{Binding BatteryStateText}" />
                        </Border>
                    </Grid>

                    <Grid Grid.Row="1" Margin="0,10,0,0" VerticalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="300" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Grid Width="272" Height="176" VerticalAlignment="Center" Margin="0,0,8,0">
                            <Border Width="236"
                                    Height="108"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Center"
                                    CornerRadius="26"
                                    BorderThickness="4"
                                    BorderBrush="{Binding BatteryAccentColor}"
                                    Background="#0B1624" />
                            <Border Width="30"
                                    Height="46"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center"
                                    CornerRadius="0,14,14,0"
                                    BorderThickness="4"
                                    BorderBrush="{Binding BatteryAccentColor}"
                                    Background="#0B1624" />
                            <Border Width="{Binding BatteryFillWidth}"
                                    MaxWidth="196"
                                    Height="74"
                                    Margin="24,0,0,0"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Center"
                                    CornerRadius="16"
                                    Background="{StaticResource MetricGlow}"
                                    Opacity="0.95" />
                            <Border Width="{Binding BatteryFillWidth}"
                                    MaxWidth="196"
                                    Height="24"
                                    Margin="24,-30,0,0"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Center"
                                    CornerRadius="12"
                                    Background="#D8FFF0"
                                    Opacity="0.16" />
                            <Path Data="M 132,48 L 112,90 L 137,90 L 122,128 L 164,74 L 138,74 L 154,48 Z"
                                  Fill="#E6FFF5"
                                  Opacity="0.78"
                                  Stretch="Uniform"
                                  Width="58"
                                  Height="86"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center" />
                        </Grid>

                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="6,0,0,0">
                            <TextBlock Foreground="{Binding BatteryAccentColor}"
                                       FontSize="72"
                                       LineHeight="74"
                                       FontWeight="Bold"
                                       Text="{Binding BatteryLevelText}" />
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>

            <Border Grid.Column="1" Style="{StaticResource PanelCard}" Margin="12,0,0,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Canvas IsHitTestVisible="False">
                        <Ellipse Width="210" Height="210" Fill="#173C58" Opacity="0.16" Canvas.Left="392" Canvas.Top="120" />
                        <Ellipse Width="128" Height="128" Fill="#244D6A" Opacity="0.10" Canvas.Left="28" Canvas.Top="-18" />
                    </Canvas>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel>
                            <TextBlock Text="速度监控"
                                       Style="{StaticResource DashboardTitle}"
                                       FontSize="24" />
                        </StackPanel>

                        <Border Grid.Column="1"
                                Padding="12,6"
                                CornerRadius="14"
                                BorderBrush="#29445E"
                                BorderThickness="1"
                                Background="#132033">
                            <TextBlock Foreground="{Binding SpeedAccentColor}"
                                       FontWeight="SemiBold"
                                       Text="{Binding SpeedStatus}" />
                        </Border>
                    </Grid>

                    <Grid Grid.Row="1" Margin="0,6,0,0" VerticalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="420" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Grid Width="384" Height="248" VerticalAlignment="Center">
                            <Ellipse Width="308"
                                     Height="308"
                                     Stroke="#14314B"
                                     StrokeThickness="1"
                                     Opacity="0.22"
                                     HorizontalAlignment="Center"
                                     VerticalAlignment="Top"
                                     Margin="0,-6,0,0" />
                            <Ellipse Width="246"
                                     Height="246"
                                     Stroke="#16314A"
                                     StrokeThickness="1"
                                     Opacity="0.16"
                                     HorizontalAlignment="Center"
                                     VerticalAlignment="Top"
                                     Margin="0,26,0,0" />
                            <Path Stroke="#183650"
                                  StrokeThickness="16"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"
                                  Data="M 48,190 A 144,144 0 1 1 336,190" />
                            <Path Stroke="{StaticResource MetricGlow}"
                                  StrokeThickness="16"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"
                                  Data="M 48,190 A 144,144 0 0 1 336,190"
                                  Opacity="0.94" />
                            <Path Data="M 86,190 L 98,190 M 117,117 L 125,125 M 192,86 L 192,98 M 267,117 L 259,125 M 298,190 L 286,190"
                                  Stroke="#A5B9CA"
                                  StrokeThickness="2"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"
                                  Opacity="0.82" />
                            <Line X1="192"
                                  Y1="190"
                                  X2="192"
                                  Y2="58"
                                  Stroke="#F3FFF9"
                                  StrokeThickness="4"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round">
                                <Line.RenderTransform>
                                    <RotateTransform Angle="{Binding SpeedGaugeAngle}"
                                                     CenterX="192"
                                                     CenterY="190" />
                                </Line.RenderTransform>
                            </Line>
                            <Ellipse Width="24"
                                     Height="24"
                                     Fill="#68E3B7"
                                     Stroke="#D9FFF4"
                                     StrokeThickness="2"
                                     HorizontalAlignment="Center"
                                     VerticalAlignment="Top"
                                     Margin="0,178,0,0" />
                            <Ellipse Width="8"
                                     Height="8"
                                     Fill="#F3FFFB"
                                     HorizontalAlignment="Center"
                                     VerticalAlignment="Top"
                                     Margin="0,186,0,0" />
                            <TextBlock Text="0"
                                       Foreground="{StaticResource SecondaryText}"
                                       FontSize="12"
                                       Margin="58,180,0,0"
                                       HorizontalAlignment="Left"
                                       VerticalAlignment="Top" />
                            <TextBlock Text="10"
                                       Foreground="{StaticResource SecondaryText}"
                                       FontSize="12"
                                       Margin="0,56,0,0"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Top" />
                            <TextBlock Text="20"
                                       Foreground="{StaticResource SecondaryText}"
                                       FontSize="12"
                                       Margin="0,180,58,0"
                                       HorizontalAlignment="Right"
                                       VerticalAlignment="Top" />
                        </Grid>

                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="8,0,0,0">
                            <TextBlock Margin="0,10,0,0"
                                       Foreground="{Binding SpeedAccentColor}"
                                       FontSize="96"
                                       LineHeight="98"
                                       FontWeight="Bold"
                                       Text="{Binding CurrentSpeedText}" />
                            <TextBlock Margin="0,-6,0,0"
                                       Foreground="{StaticResource PrimaryText}"
                                       FontSize="30"
                                       FontWeight="Light"
                                       Text="{Binding SpeedUnit}" />
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <Border Grid.Row="2"
                Margin="24,0,24,16"
                Style="{StaticResource PanelCard}"
                Background="{StaticResource SubtlePanelBackground}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                </Grid>

                <UniformGrid Grid.Row="1" Margin="0,18,0,0" Rows="1" Columns="4">
                    <Border Margin="0,0,12,0"
                            CornerRadius="18"
                            BorderBrush="#223753"
                            BorderThickness="1"
                            Background="#101A2A"
                            Padding="16">
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Margin="0,12,0,0" Foreground="{StaticResource PrimaryText}" FontSize="20" FontWeight="SemiBold" Text="占位1" />
                        </StackPanel>
                    </Border>

                    <Border Margin="12,0"
                            CornerRadius="18"
                            BorderBrush="#223753"
                            BorderThickness="1"
                            Background="#101A2A"
                            Padding="16">
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Margin="0,12,0,0" Foreground="{StaticResource PrimaryText}" FontSize="20" FontWeight="SemiBold" Text="占位2" />
                        </StackPanel>
                    </Border>

                    <Border Margin="12,0"
                            CornerRadius="18"
                            BorderBrush="#223753"
                            BorderThickness="1"
                            Background="#101A2A"
                            Padding="16">
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Margin="0,12,0,0" Foreground="{StaticResource PrimaryText}" FontSize="20" FontWeight="SemiBold" Text="占位3" />
                        </StackPanel>
                    </Border>

                    <Border Margin="12,0,0,0"
                            CornerRadius="18"
                            BorderBrush="#223753"
                            BorderThickness="1"
                            Background="#101A2A"
                            Padding="16">
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Margin="0,12,0,0" Foreground="{StaticResource PrimaryText}" FontSize="20" FontWeight="SemiBold" Text="占位4" />
                        </StackPanel>
                    </Border>
                </UniformGrid>
            </Grid>
        </Border>

        <!-- <Border Grid.Row="3" -->
        <!--         Margin="24,0,24,20" -->
        <!--         Padding="16,12" -->
        <!--         CornerRadius="18" -->
        <!--         Background="#091420" -->
        <!--         BorderBrush="#20344D" -->
        <!--         BorderThickness="1"> -->
        <!--     <Grid> -->
        <!--         <Grid.ColumnDefinitions> -->
        <!--             <ColumnDefinition Width="*" /> -->
        <!--             <ColumnDefinition Width="Auto" /> -->
        <!--         </Grid.ColumnDefinitions> -->
        <!-- -->
        <!--         <StackPanel Orientation="Horizontal"> -->
        <!--             <TextBlock Foreground="{StaticResource SecondaryText}" Text="模式: 演示模式" /> -->
        <!--             <TextBlock Margin="20,0,0,0" Foreground="{StaticResource SecondaryText}" Text="通讯: 预留" /> -->
        <!--             <TextBlock Margin="20,0,0,0" Foreground="{StaticResource SecondaryText}" Text="PLC: 后续接入" /> -->
        <!--         </StackPanel> -->
        <!-- -->
        <!--         <TextBlock Grid.Column="1" -->
        <!--                    Foreground="{StaticResource SecondaryText}" -->
        <!--                    Text="GrindCar HMI v1.0" /> -->
        <!--     </Grid> -->
        <!-- </Border> -->
    </Grid>
</Window>
