<Window x:Class="GrindCar.Views.GrindDepthDebugWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="打磨深度调试"
        Width="920"
        Height="680"
        MinWidth="820"
        MinHeight="620"
        WindowStartupLocation="CenterOwner"
        Background="#F4F6F8">
    <Window.Resources>
        <SolidColorBrush x:Key="CardBackground" Color="#FFFFFF" />
        <SolidColorBrush x:Key="CardBorder" Color="#DCE3E8" />
        <SolidColorBrush x:Key="Ink" Color="#1E2A32" />
        <SolidColorBrush x:Key="Muted" Color="#61727D" />
        <SolidColorBrush x:Key="Accent" Color="#0F7A6C" />
        <SolidColorBrush x:Key="AccentSoft" Color="#E8F6F3" />

        <Style x:Key="CardBorderStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource CardBackground}" />
            <Setter Property="BorderBrush" Value="{StaticResource CardBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Padding" Value="18" />
        </Style>
    </Window.Resources>

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Style="{StaticResource CardBorderStyle}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <TextBlock FontSize="24"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource Ink}"
                               Text="打磨深度调试" />
                    <TextBlock Margin="0,6,0,0"
                               Foreground="{StaticResource Muted}"
                                />
                </StackPanel>

                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <Button x:Name="CalculateButton"
                            Width="120"
                            Height="34"
                            Margin="0,0,10,0"
                            Content="开始计算"
                            Click="Calculate_Click" />
                    <Button Width="88"
                            Height="34"
                            Content="关闭"
                            Click="Close_Click" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1"
              Margin="0,14,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.4*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="220" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Style="{StaticResource CardBorderStyle}"
                    Margin="0,0,12,0">
                <StackPanel>
                    <TextBlock Foreground="{StaticResource Muted}"
                               Text="打磨角度输入" />
                    <TextBox x:Name="AnglesTextBox"
                             Margin="0,8,0,0"
                             MinHeight="96"
                             AcceptsReturn="True"
                             TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto"
                             VerticalContentAlignment="Top"
                             Text="-20,-15,-10,-5,-2,0,2,5,10,15,25,35,45,55,65,75,83" />
                    <TextBlock Margin="0,8,0,0"
                               Foreground="{StaticResource Muted}"
                               />
                </StackPanel>
            </Border>

            <Border Grid.Column="2"
                    Style="{StaticResource CardBorderStyle}"
                    Background="{StaticResource AccentSoft}">
                <StackPanel>
                    <!-- <TextBlock Foreground="{StaticResource Muted}" -->
                    <!--            Text="结果数量" /> -->
                    <TextBlock x:Name="ResultCountTextBlock"
                               Margin="0,8,0,0"
                               FontSize="32"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource Accent}"
                               Text="0" />
                </StackPanel>
            </Border>
        </Grid>

        <Border Grid.Row="2"
                Style="{StaticResource CardBorderStyle}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <StackPanel>
                    <TextBlock FontSize="20"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource Ink}"
                               Text="计算结果" />
                    <TextBlock Margin="0,6,0,0"
                               Foreground="{StaticResource Muted}"/>
                </StackPanel>

                <DataGrid Grid.Row="1"
                          Margin="0,14,0,0"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          CanUserAddRows="False"
                          HeadersVisibility="Column"
                          ItemsSource="{Binding Results}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Width="*"
                                            Header="角度"
                                            Binding="{Binding Angle}" />
                        <DataGridTextColumn Width="*"
                                            Header="打磨深度"
                                            Binding="{Binding GrindDepth, StringFormat=F6}" />
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>

        <Border Grid.Row="3"
                Margin="0,14,0,0"
                Style="{StaticResource CardBorderStyle}">
            <TextBlock x:Name="StatusTextBlock"
                       Foreground="{StaticResource Muted}"
                       TextWrapping="Wrap" />
        </Border>
    </Grid>
</Window>
