<Window x:Class="GrindCar.Views.GrindDepthDebugWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="打磨深度调试"
        Width="1120"
        Height="820"
        MinWidth="820"
        MinHeight="700"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBackgroundBrush}">
    <Window.Resources>

        <Style x:Key="CardBorderStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Padding" Value="18" />
        </Style>

        <Style TargetType="TextBox" x:Key="DebugTextBoxStyle">
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
            <Setter Property="Background" Value="{DynamicResource InputBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}" />
            <Setter Property="CaretBrush" Value="{DynamicResource PrimaryTextBrush}" />
        </Style>

    </Window.Resources>

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Style="{StaticResource CardBorderStyle}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <TextBlock FontSize="24"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource PrimaryTextBrush}"
                               Text="打磨深度调试" />
                    <TextBlock Margin="0,6,0,0"
                               Foreground="{DynamicResource MutedTextBrush}"
                                />
                </StackPanel>

                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <Button x:Name="CalculateButton"
                            Width="150"
                            Height="34"
                            Margin="0,0,10,0"
                            Content="计算需要打磨深度"
                            IsEnabled="{Binding CanRunActions}"
                            Click="Calculate_Click" />
                    <Button x:Name="DetectButton"
                            Width="150"
                            Height="34"
                            Margin="0,0,10,0"
                            Content="检测已打磨深度"
                            IsEnabled="{Binding CanRunActions}"
                            Click="Detect_Click" />
                    <Button x:Name="ExportRepresentativePointsButton"
                            Width="120"
                            Height="34"
                            Margin="0,0,10,0"
                            Content="导出代表点"
                            Click="ExportRepresentativePoints_Click"
                            IsEnabled="{Binding CanExportRepresentativePoints}" />
                    <Button Width="88"
                            Height="34"
                            Content="关闭"
                            Click="Close_Click" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1"
              Margin="0,14,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.4*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="220" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Style="{StaticResource CardBorderStyle}"
                    Margin="0,0,12,0">
                <StackPanel>
                    <TextBlock Foreground="{DynamicResource MutedTextBrush}"
                               Text="打磨角度输入" />
                    <TextBox x:Name="AnglesTextBox"
                             Margin="0,8,0,0"
                             MinHeight="96"
                             AcceptsReturn="True"
                             TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto"
                             VerticalContentAlignment="Top"
                             Foreground="{DynamicResource PrimaryTextBrush}"
                             Background="{DynamicResource InputBackgroundBrush}"
                             BorderBrush="{DynamicResource CardBorderBrush}"
                             IsEnabled="{Binding CanEditAngles}"
                             Text="{Binding AnglesInput, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Margin="0,8,0,0"
                               Foreground="{DynamicResource MutedTextBrush}"
                               />
                </StackPanel>
            </Border>

            <Border Grid.Column="2"
                    Style="{StaticResource CardBorderStyle}"
                    Background="{DynamicResource AccentSoftBrush}">
                <StackPanel>
                    <!-- <TextBlock Foreground="{DynamicResource MutedTextBrush}" -->
                    <!--            Text="结果数量" /> -->
                    <TextBlock x:Name="ResultCountTextBlock"
                               Margin="0,8,0,0"
                               FontSize="32"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource AccentBrush}"
                               Text="{Binding ResultCountText}" />
                </StackPanel>
            </Border>
        </Grid>

        <Grid Grid.Row="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Style="{StaticResource CardBorderStyle}"
                    Margin="0,0,0,14">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <StackPanel>
                        <TextBlock FontSize="20"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource PrimaryTextBrush}"
                                   Text="需要打磨深度" />
                    </StackPanel>

                    <DataGrid Grid.Row="1"
                              Margin="0,14,0,0"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              CanUserAddRows="False"
                              HeadersVisibility="Column"
                              Background="{DynamicResource DataGridBackgroundBrush}"
                              Foreground="{DynamicResource PrimaryTextBrush}"
                              BorderBrush="{DynamicResource CardBorderBrush}"
                              ItemsSource="{Binding RequiredResults}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Width="*"
                                                Header="角度"
                                                Binding="{Binding Angle}" />
                            <DataGridTextColumn Width="*"
                                                Header="打磨深度"
                                                Binding="{Binding GrindDepth, StringFormat=F6}" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>

            <Border Grid.Row="1"
                    Style="{StaticResource CardBorderStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <StackPanel>
                        <TextBlock FontSize="20"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource PrimaryTextBrush}"
                                   Text="已打磨深度检测结果" />
                    </StackPanel>

                    <DataGrid Grid.Row="1"
                              Margin="0,14,0,0"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              CanUserAddRows="False"
                              HeadersVisibility="Column"
                              Background="{DynamicResource DataGridBackgroundBrush}"
                              Foreground="{DynamicResource PrimaryTextBrush}"
                              BorderBrush="{DynamicResource CardBorderBrush}"
                              ItemsSource="{Binding DetectedResults}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Width="*"
                                                Header="角度"
                                                Binding="{Binding Angle}" />
                            <DataGridTextColumn Width="*"
                                                Header="基线 b"
                                                Binding="{Binding BaselineB, StringFormat=F6}" />
                            <DataGridTextColumn Width="*"
                                                Header="当前 b"
                                                Binding="{Binding CurrentB, StringFormat=F6}" />
                            <DataGridTextColumn Width="*"
                                                Header="已打磨深度"
                                                Binding="{Binding DetectedDepth, StringFormat=F6}" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>
        </Grid>

        <Border Grid.Row="3"
                Margin="0,14,0,0"
                Style="{StaticResource CardBorderStyle}">
            <TextBlock x:Name="StatusTextBlock"
                       Foreground="{DynamicResource MutedTextBrush}"
                       TextWrapping="Wrap"
                       Text="{Binding StatusMessage}" />
        </Border>
    </Grid>
</Window>
