<Window x:Class="GrindCar.Views.PlcConnectionSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PLC连接设置"
        Width="460"
        Height="250"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#F4F6F8">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock FontSize="20"
                   FontWeight="SemiBold"
                   Foreground="#1E2A32"
                   Text="PLC连接设置" />

        <Grid Grid.Row="1" Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="80" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock VerticalAlignment="Center" Foreground="#1E2A32" Text="IP" />
            <TextBox x:Name="IpAddressTextBox"
                     Grid.Column="1"
                     Height="32"
                     VerticalContentAlignment="Center" />
        </Grid>

        <Grid Grid.Row="2" Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="80" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock VerticalAlignment="Center" Foreground="#1E2A32" Text="Port" />
            <TextBox x:Name="PortTextBox"
                     Grid.Column="1"
                     Height="32"
                     VerticalContentAlignment="Center" />
        </Grid>

        <StackPanel Grid.Row="3"
                    Margin="0,12,0,0"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right">
            <Button Width="86"
                    Height="32"
                    Margin="0,0,10,0"
                    Content="取消"
                    Click="Cancel_Click" />
            <Button Width="86"
                    Height="32"
                    Content="确定"
                    Click="Confirm_Click" />
        </StackPanel>
    </Grid>
</Window>
