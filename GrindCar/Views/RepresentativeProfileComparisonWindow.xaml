<Window x:Class="GrindCar.Views.RepresentativeProfileComparisonWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="代表轨面曲线对比"
        Width="980"
        Height="720"
        MinWidth="860"
        MinHeight="620"
        WindowStartupLocation="CenterOwner"
        Background="#F4F6F8">
    <Window.Resources>
        <SolidColorBrush x:Key="CardBackground" Color="#FFFFFF" />
        <SolidColorBrush x:Key="CardBorder" Color="#DCE3E8" />
        <SolidColorBrush x:Key="Ink" Color="#1E2A32" />
        <SolidColorBrush x:Key="Muted" Color="#61727D" />
        <SolidColorBrush x:Key="RepresentativeBrush" Color="#0F7A6C" />
        <SolidColorBrush x:Key="StandardBrush" Color="#D96C06" />
        <SolidColorBrush x:Key="PointBrush" Color="#125A51" />

        <Style x:Key="CardBorderStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource CardBackground}" />
            <Setter Property="BorderBrush" Value="{StaticResource CardBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Padding" Value="18" />
        </Style>
    </Window.Resources>

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Style="{StaticResource CardBorderStyle}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <TextBlock FontSize="24"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource Ink}"
                               Text="代表轨面与标准轨面曲线对比" />
                    <TextBlock Margin="0,6,0,0"
                               Foreground="{StaticResource Muted}"
                               Text="绿色为代表拟合曲线，橙色为标准轨面曲线。" />
                </StackPanel>

                <Button Grid.Column="1"
                        Width="88"
                        Height="34"
                        Content="关闭"
                        Click="Close_Click" />
            </Grid>
        </Border>

        <Border Grid.Row="1"
                Margin="0,14,0,14"
                Style="{StaticResource CardBorderStyle}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <TextBlock Foreground="{StaticResource Muted}"
                               Text="代表点数量" />
                    <TextBlock
                               Margin="0,8,0,0"
                               FontSize="28"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource RepresentativeBrush}"
                               Text="{Binding PointCountText}" />
                </StackPanel>

                <StackPanel Grid.Column="1">
                    <TextBlock Foreground="{StaticResource Muted}"
                               Text="横向范围" />
                    <TextBlock
                               Margin="0,8,0,0"
                               FontSize="28"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource Ink}"
                               Text="{Binding XRangeText}" />
                </StackPanel>

                <StackPanel Grid.Column="2">
                    <TextBlock Foreground="{StaticResource Muted}"
                               Text="高度范围" />
                    <TextBlock
                               Margin="0,8,0,0"
                               FontSize="28"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource StandardBrush}"
                               Text="{Binding YRangeText}" />
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="2"
                Style="{StaticResource CardBorderStyle}">
            <Grid>
                <Canvas x:Name="PlotCanvas"
                        Background="#FCFDFD"
                        SizeChanged="PlotCanvas_SizeChanged">
                    <Line
                          Stroke="#B9C6CE"
                          StrokeThickness="1"
                          StrokeDashArray="4,4"
                          X1="{Binding XAxisX1}"
                          X2="{Binding XAxisX2}"
                          Y1="{Binding XAxisY1}"
                          Y2="{Binding XAxisY2}" />
                    <Line
                          Stroke="#B9C6CE"
                          StrokeThickness="1"
                          StrokeDashArray="4,4"
                          X1="{Binding YAxisX1}"
                          X2="{Binding YAxisX2}"
                          Y1="{Binding YAxisY1}"
                          Y2="{Binding YAxisY2}" />
                    <Path
                          Stroke="{StaticResource StandardBrush}"
                          StrokeThickness="2.5"
                          StrokeStartLineCap="Round"
                          StrokeEndLineCap="Round"
                          Data="{Binding StandardCurveGeometry}" />
                    <Path
                          Stroke="{StaticResource RepresentativeBrush}"
                          StrokeThickness="3"
                          StrokeStartLineCap="Round"
                          StrokeEndLineCap="Round"
                          Data="{Binding RepresentativeCurveGeometry}" />
                    <ItemsControl ItemsSource="{Binding RepresentativePointItems}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <Canvas />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemContainerStyle>
                            <Style TargetType="ContentPresenter">
                                <Setter Property="Canvas.Left"
                                        Value="{Binding Left}" />
                                <Setter Property="Canvas.Top"
                                        Value="{Binding Top}" />
                            </Style>
                        </ItemsControl.ItemContainerStyle>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Ellipse Width="5"
                                         Height="5"
                                         Fill="{StaticResource PointBrush}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Canvas>
            </Grid>
        </Border>
    </Grid>
</Window>
