<Window x:Class="GrindCar.Views.RepresentativeProfileComparisonWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="代表轨面曲线对比"
        Width="980"
        Height="720"
        MinWidth="860"
        MinHeight="620"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBackgroundBrush}">
    <Window.Resources>

        <Style x:Key="CardBorderStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Padding" Value="18" />
        </Style>

    </Window.Resources>

    <Grid Margin="18" Background="{DynamicResource WindowBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <WrapPanel Margin="0,0,0,10" Visibility="{Binding MeasurementControlsVisibility}">
            <ComboBox Width="130" Margin="0,0,20,0" MinHeight="34"
                      Visibility="{Binding ProfileSelectorVisibility}"
                      ItemsSource="{Binding Profiles}" SelectedItem="{Binding SelectedProfile}"
                      DisplayMemberPath="DisplayName" />
            <TextBlock Text="━ 代表廓形" Foreground="{DynamicResource RepresentativeBrush}" VerticalAlignment="Center" Margin="0,0,20,0" />
            <TextBlock Text="━ 标准廓形" Foreground="{DynamicResource StandardBrush}" VerticalAlignment="Center" />
        </WrapPanel>
        <Border Grid.Row="1" Style="{StaticResource CardBorderStyle}">
            <Grid>
                <Canvas x:Name="PlotCanvas"
                        Background="{DynamicResource CanvasBackgroundBrush}"
                        SizeChanged="PlotCanvas_SizeChanged">
                    <Line
                          Stroke="{DynamicResource CanvasAxisBrush}"
                          StrokeThickness="1"
                          StrokeDashArray="4,4"
                          X1="{Binding XAxisX1}"
                          X2="{Binding XAxisX2}"
                          Y1="{Binding XAxisY1}"
                          Y2="{Binding XAxisY2}" />
                    <Line
                          Stroke="{DynamicResource CanvasAxisBrush}"
                          StrokeThickness="1"
                          StrokeDashArray="4,4"
                          X1="{Binding YAxisX1}"
                          X2="{Binding YAxisX2}"
                          Y1="{Binding YAxisY1}"
                          Y2="{Binding YAxisY2}" />
                    <Path
                          Stroke="{DynamicResource StandardBrush}"
                          StrokeThickness="2.5"
                          StrokeStartLineCap="Round"
                          StrokeEndLineCap="Round"
                          Data="{Binding StandardCurveGeometry}" />
                    <Path
                          Stroke="{DynamicResource RepresentativeBrush}"
                          StrokeThickness="3"
                          StrokeStartLineCap="Round"
                          StrokeEndLineCap="Round"
                          Data="{Binding RepresentativeCurveGeometry}" />
                    <Path
                          Stroke="{DynamicResource LeftBrush}"
                          StrokeThickness="3"
                          StrokeStartLineCap="Round"
                          StrokeEndLineCap="Round"
                          Data="{Binding LeftCurveGeometry}" />
                    <Path
                          Stroke="{DynamicResource RightBrush}"
                          StrokeThickness="3"
                          StrokeStartLineCap="Round"
                          StrokeEndLineCap="Round"
                          Data="{Binding RightCurveGeometry}" />
                    <ItemsControl ItemsSource="{Binding RepresentativePointItems}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <Canvas />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemContainerStyle>
                            <Style TargetType="ContentPresenter">
                                <Setter Property="Canvas.Left"
                                        Value="{Binding Left}" />
                                <Setter Property="Canvas.Top"
                                        Value="{Binding Top}" />
                            </Style>
                        </ItemsControl.ItemContainerStyle>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Ellipse Width="5"
                                         Height="5"
                                         Fill="{DynamicResource PointBrush}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <ItemsControl ItemsSource="{Binding LeftPointItems}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <Canvas />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemContainerStyle>
                            <Style TargetType="ContentPresenter">
                                <Setter Property="Canvas.Left"
                                        Value="{Binding Left}" />
                                <Setter Property="Canvas.Top"
                                        Value="{Binding Top}" />
                            </Style>
                        </ItemsControl.ItemContainerStyle>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Ellipse Width="5"
                                         Height="5"
                                         Fill="{DynamicResource LeftBrush}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <ItemsControl ItemsSource="{Binding RightPointItems}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <Canvas />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemContainerStyle>
                            <Style TargetType="ContentPresenter">
                                <Setter Property="Canvas.Left"
                                        Value="{Binding Left}" />
                                <Setter Property="Canvas.Top"
                                        Value="{Binding Top}" />
                            </Style>
                        </ItemsControl.ItemContainerStyle>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Ellipse Width="5"
                                         Height="5"
                                         Fill="{DynamicResource RightBrush}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <ItemsControl Panel.ZIndex="10"
                                  ItemsSource="{Binding MaximumDropMarkerItems}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <Canvas />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemContainerStyle>
                            <Style TargetType="ContentPresenter">
                                <Setter Property="Canvas.Left"
                                        Value="{Binding Left}" />
                                <Setter Property="Canvas.Top"
                                        Value="{Binding Top}" />
                            </Style>
                        </ItemsControl.ItemContainerStyle>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Ellipse Width="12"
                                             Height="12"
                                             HorizontalAlignment="Left"
                                             VerticalAlignment="Top"
                                             Fill="{DynamicResource MaximumDepthBrush}"
                                             Stroke="{DynamicResource CanvasBackgroundBrush}"
                                             StrokeThickness="2" />
                                    <Border Margin="16,-22,0,0"
                                            Padding="6,4"
                                            HorizontalAlignment="Left"
                                            VerticalAlignment="Top"
                                            Background="{DynamicResource CardBackgroundBrush}"
                                            BorderBrush="{DynamicResource MaximumDepthBrush}"
                                            BorderThickness="1"
                                            CornerRadius="4">
                                        <TextBlock Foreground="{DynamicResource PrimaryTextBrush}"
                                                   FontSize="11"
                                                   Text="{Binding Label}" />
                                    </Border>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Canvas>
                <TextBlock Text="{Binding PlotError}" TextWrapping="Wrap" Margin="12"
                           Foreground="{DynamicResource PrimaryTextBrush}"
                           HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False" />
            </Grid>
        </Border>
    </Grid>
</Window>
