<Window x:Class="GrindCar.Views.MotorDebugWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:conv="clr-namespace:GrindCar.Converters"
        mc:Ignorable="d"
        Title="电机调试"
        Width="1100"
        Height="780"
        WindowStartupLocation="CenterOwner"
        Background="#F4F6F8">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <conv:InverseBooleanToVisibilityConverter x:Key="InverseBoolToVisibility" />
        <conv:InverseBooleanConverter x:Key="InverseBool" />

        <SolidColorBrush x:Key="CardBg" Color="#FFFFFF" />
        <SolidColorBrush x:Key="Ink" Color="#1E2A32" />
        <SolidColorBrush x:Key="Muted" Color="#5B6B74" />
        <SolidColorBrush x:Key="Accent" Color="#0F7A6C" />
        <SolidColorBrush x:Key="Line" Color="#E1E6EA" />

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Ink}" />
        </Style>

        <Style x:Key="HeaderText" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe UI Semibold" />
            <Setter Property="FontSize" Value="20" />
            <Setter Property="Foreground" Value="{StaticResource Ink}" />
        </Style>

        <Style x:Key="SubHeaderText" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe UI" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{StaticResource Muted}" />
        </Style>

        <Style x:Key="RowName" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe UI" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="FontFamily" Value="Consolas" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="BorderBrush" Value="{StaticResource Line}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Background" Value="#F9FBFC" />
        </Style>

        <Style TargetType="Border" x:Key="Card">
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Background" Value="{StaticResource CardBg}" />
            <Setter Property="BorderBrush" Value="{StaticResource Line}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="18" />
        </Style>

        <Style x:Key="BoolSwitchButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="58" />
            <Setter Property="Height" Value="30" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Width="{TemplateBinding Width}"
                                Height="{TemplateBinding Height}"
                                Background="Transparent">
                            <Grid Width="56"
                                  Height="28"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center">
                                <Border x:Name="Track"
                                        CornerRadius="14"
                                        Background="#D8E0E5"
                                        BorderBrush="#C4CED6"
                                        BorderThickness="1" />
                                <Grid Margin="2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <Border x:Name="Thumb"
                                            Grid.Column="0"
                                            Width="24"
                                            Height="24"
                                            CornerRadius="12"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            Background="#FFFFFF"
                                            BorderBrush="#B6C0C8"
                                            BorderThickness="1" />
                                </Grid>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <DataTrigger Binding="{Binding BoolValue}" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="{StaticResource Accent}" />
                                <Setter TargetName="Track" Property="BorderBrush" Value="{StaticResource Accent}" />
                                <Setter TargetName="Thumb" Property="Grid.Column" Value="1" />
                            </DataTrigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Track" Property="BorderBrush" Value="#0B5F55" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Thumb" Property="Opacity" Value="0.86" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Cursor" Value="Arrow" />
                                <Setter TargetName="Track" Property="Opacity" Value="0.55" />
                                <Setter TargetName="Thumb" Property="Opacity" Value="0.75" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource Card}" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <TextBlock Text="电机调试参数" Style="{StaticResource HeaderText}" />
                    <TextBlock Text="{Binding ConnectionStatus}" Style="{StaticResource SubHeaderText}" Margin="0,6,0,0" />
                </StackPanel>

                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            VerticalAlignment="Center"
                            Visibility="{Binding UsesSharedConnection, Converter={StaticResource InverseBoolToVisibility}}">
                    <TextBlock Text="IP" Margin="0,0,6,0" VerticalAlignment="Center" />
                    <TextBox Width="140"
                             Text="{Binding IpAddress, UpdateSourceTrigger=PropertyChanged}"
                             IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}" />
                    <TextBlock Text="Port" Margin="12,0,6,0" VerticalAlignment="Center" />
                    <TextBox Width="70"
                             Text="{Binding Port, UpdateSourceTrigger=PropertyChanged}"
                             IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}" />
                    <Button Content="连接"
                            Width="72"
                            Height="28"
                            Margin="12,0,0,0"
                            Command="{Binding ConnectCommand}" />
                    <Button Content="断开"
                            Width="72"
                            Height="28"
                            Margin="8,0,0,0"
                            Command="{Binding DisconnectCommand}" />
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="1" Style="{StaticResource Card}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="280" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="80" />
                        <ColumnDefinition Width="100" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="参数名称" FontWeight="Bold" />
                    <TextBlock Grid.Column="1" Text="参数值 / 输入 / 切换" FontWeight="Bold" />
                    <TextBlock Grid.Column="2" Text="单位" FontWeight="Bold" />
                </Grid>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding Parameters}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" Padding="0,8">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="280" />
                                            <ColumnDefinition Width="360" />
                                            <ColumnDefinition Width="80" />
                                            <ColumnDefinition Width="100" />
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Text="{Binding Name}" Style="{StaticResource RowName}" />

                                        <TextBox Grid.Column="1"
                                                 Text="{Binding Value}"
                                                 Width="180"
                                                 IsReadOnly="True"
                                                 Background="#EEF2F4"
                                                 BorderBrush="{StaticResource Line}"
                                                 Visibility="{Binding IsReadOnly, Converter={StaticResource BoolToVisibility}}" />

                                        <TextBox Grid.Column="1"
                                                 Text="{Binding InputValue, UpdateSourceTrigger=PropertyChanged}"
                                                 Width="180"
                                                 VerticalAlignment="Center"
                                                 Visibility="{Binding IsValueWrite, Converter={StaticResource BoolToVisibility}}" />

                                        <Button Grid.Column="1"
                                                Style="{StaticResource BoolSwitchButtonStyle}"
                                                HorizontalAlignment="Left"
                                                Visibility="{Binding IsBoolWrite, Converter={StaticResource BoolToVisibility}}"
                                                Command="{Binding DataContext.ModifyCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}" />

                                        <ItemsControl Grid.Column="1"
                                                      ItemsSource="{Binding CommandOptions}"
                                                      Visibility="{Binding HasCommandOptions, Converter={StaticResource BoolToVisibility}}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <StackPanel Orientation="Horizontal" />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Button Content="{Binding DisplayName}"
                                                            Width="72"
                                                            Height="28"
                                                            Margin="0,0,8,0"
                                                            Command="{Binding DataContext.CommandOptionCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding}" />
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>

                                        <TextBlock Grid.Column="2"
                                                   Text="{Binding Unit}"
                                                   Style="{StaticResource SubHeaderText}"
                                                   VerticalAlignment="Center" />

                                        <Button Grid.Column="3"
                                                Content="修改"
                                                Width="72"
                                                Height="28"
                                                HorizontalAlignment="Left"
                                                Visibility="{Binding IsValueWrite, Converter={StaticResource BoolToVisibility}}"
                                                Command="{Binding DataContext.ModifyCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</Window>
