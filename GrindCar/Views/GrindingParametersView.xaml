<UserControl x:Class="GrindCar.Views.GrindingParametersView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource PrimaryTextBrush}">
    <UserControl.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style TargetType="TextBox" BasedOn="{StaticResource RoundedTextBoxStyle}">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Padding" Value="8,5" />
        </Style>
        <Style TargetType="Button" BasedOn="{StaticResource SecondaryButtonStyle}">
            <Setter Property="Margin" Value="0,0,12,8" />
        </Style>
        <DataTemplate x:Key="FieldTemplate">
            <StackPanel Margin="0,0,16,12" MinWidth="260">
                <TextBlock Text="{Binding Label}" Foreground="{DynamicResource PrimaryTextBrush}" FontSize="14" Margin="0,0,0,5" />
                <TextBox Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}" />
            </StackPanel>
        </DataTemplate>
    </UserControl.Resources>
    <DockPanel Background="{DynamicResource WindowBackgroundBrush}">
        <StackPanel DockPanel.Dock="Bottom" Margin="20,10,20,16">
            <WrapPanel>
                <Button Content="保存本地" Click="Save_Click" IsEnabled="{Binding CanEdit}" />
                <Button Content="写入全部参数" Click="WriteAll_Click" IsEnabled="{Binding CanWrite}" />
                <Button Content="写入当前角度参数" Click="WriteAngle_Click" IsEnabled="{Binding CanWrite}" />
            </WrapPanel>
            <TextBlock Text="{Binding SaveStatus}" Margin="0,4" />
            <ScrollViewer MaxHeight="96" VerticalScrollBarVisibility="Auto">
                <TextBlock Text="{Binding WriteStatus}" Margin="0,4" />
            </ScrollViewer>
        </StackPanel>
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="20" MinWidth="620">
            <TextBlock Text="打磨参数设置" FontSize="24" FontWeight="SemiBold" Margin="0,0,0,12" />
            <TextBlock Text="{Binding ConnectionStatus}" />
            <TextBlock Text="{Binding RunningStatus}" Margin="0,6,0,14" />
            <ItemsControl ItemsSource="{Binding BasicFields}" ItemTemplate="{StaticResource FieldTemplate}" IsEnabled="{Binding CanEdit}">
                <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="2" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
            </ItemsControl>
            <StackPanel Margin="0,8,0,16" IsEnabled="{Binding CanEdit}">
                <TextBlock Text="选择打磨角度" Margin="0,0,0,6" />
                <ComboBox x:Name="AngleSelector" Width="200" Height="36" FontSize="14"
                          HorizontalAlignment="Left" VerticalContentAlignment="Center"
                          IsEditable="False" MaxDropDownHeight="320"
                          ItemsSource="{Binding Angles}" SelectedItem="{Binding SelectedAngle, Mode=TwoWay}">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Angle, StringFormat={}{0}°}"
                                       Foreground="{DynamicResource {x:Static SystemColors.ControlTextBrushKey}}" />
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
                <TextBlock Text="{Binding SelectedAngle.AngleLabel}" FontWeight="SemiBold" Margin="0,14,0,8" />
                <WrapPanel Margin="0,0,0,14">
                    <TextBlock Text="打磨次数：" />
                    <TextBlock Text="{Binding SelectedAngle.Times}" Margin="0,0,24,0" />
                    <TextBlock Text="次数写入状态：" />
                    <TextBlock Text="{Binding SelectedAngle.TimesWriteState}" />
                </WrapPanel>
                <ItemsControl ItemsSource="{Binding SelectedAngle.Fields}" ItemTemplate="{StaticResource FieldTemplate}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><UniformGrid Columns="2" /></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>
            </StackPanel>
            <TextBlock Text="角度固定；次数由测量确认流程产生，参数写入不包含次数。运行状态未知或运行中时不能写入。" Margin="0,0,0,12" />
        </StackPanel>
    </ScrollViewer>
    </DockPanel>
</UserControl>
