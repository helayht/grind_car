<Window x:Class="GrindCar.Views.MedianSectionDebugWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="中位截面调试"
        Width="1240"
        Height="760"
        MinWidth="1080"
        MinHeight="680"
        WindowStartupLocation="CenterOwner"
        Background="#F4F6F8">
    <Window.Resources>
        <SolidColorBrush x:Key="CardBackground" Color="#FFFFFF" />
        <SolidColorBrush x:Key="CardBorder" Color="#DCE3E8" />
        <SolidColorBrush x:Key="Ink" Color="#1E2A32" />
        <SolidColorBrush x:Key="Muted" Color="#61727D" />
        <SolidColorBrush x:Key="Accent" Color="#0F7A6C" />
        <SolidColorBrush x:Key="AccentSoft" Color="#E8F6F3" />
        <SolidColorBrush x:Key="PlotStroke" Color="#138B7B" />
        <SolidColorBrush x:Key="PlotAxis" Color="#AEBBC4" />
        <SolidColorBrush x:Key="PlotBackground" Color="#FBFCFD" />

        <Style x:Key="CardBorderStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource CardBackground}" />
            <Setter Property="BorderBrush" Value="{StaticResource CardBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Padding" Value="18" />
        </Style>
    </Window.Resources>

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Style="{StaticResource CardBorderStyle}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <TextBlock FontSize="24"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource Ink}"
                               Text="中位 X 截面调试" />
                    <TextBlock Margin="0,6,0,0"
                               Foreground="{StaticResource Muted}"
                               Text="导入 .csv 点云文件，提取去重后中位 X 截面的代表点集 (Y, Z)。" />
                </StackPanel>

                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <Button Width="120"
                            Height="34"
                            Margin="0,0,10,0"
                            Content="导入点云文件"
                            Click="ImportFile_Click" />
                    <Button Width="88"
                            Height="34"
                            Content="关闭"
                            Click="Close_Click" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1"
              Margin="0,14,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.2*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Style="{StaticResource CardBorderStyle}"
                    Margin="0,0,12,0">
                <StackPanel>
                    <TextBlock Foreground="{StaticResource Muted}"
                               Text="当前文件" />
                    <TextBlock Margin="0,8,0,0"
                               FontSize="16"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource Ink}"
                               Text="{Binding ImportedFilePath}" />
                </StackPanel>
            </Border>

            <Border Grid.Column="1"
                    Style="{StaticResource CardBorderStyle}"
                    Margin="0,0,12,0">
                <StackPanel>
                    <TextBlock Foreground="{StaticResource Muted}"
                               Text="中位 X" />
                    <TextBlock Margin="0,8,0,0"
                               FontSize="18"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource Ink}"
                               Text="{Binding MedianXText}" />
                </StackPanel>
            </Border>

            <Border Grid.Column="2"
                    Style="{StaticResource CardBorderStyle}"
                    Margin="0,0,12,0"
                    Background="{StaticResource AccentSoft}">
                <StackPanel>
                    <TextBlock Foreground="{StaticResource Muted}"
                               Text="代表点数量" />
                    <TextBlock Margin="0,8,0,0"
                               FontSize="28"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource Accent}"
                               Text="{Binding RepresentativePointCountText}" />
                </StackPanel>
            </Border>

            <Border Grid.Column="3"
                    Style="{StaticResource CardBorderStyle}"
                    Margin="0,0,12,0">
                <StackPanel>
                    <TextBlock Foreground="{StaticResource Muted}"
                               Text="Y 范围" />
                    <TextBlock Margin="0,8,0,0"
                               FontSize="18"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource Ink}"
                               Text="{Binding YRangeText}" />
                </StackPanel>
            </Border>

            <Border Grid.Column="4"
                    Style="{StaticResource CardBorderStyle}">
                <StackPanel>
                    <TextBlock Foreground="{StaticResource Muted}"
                               Text="Z 范围" />
                    <TextBlock Margin="0,8,0,0"
                               FontSize="18"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource Ink}"
                               Text="{Binding ZRangeText}" />
                </StackPanel>
            </Border>
        </Grid>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="420" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Style="{StaticResource CardBorderStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <StackPanel>
                        <TextBlock FontSize="20"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource Ink}"
                                   Text="代表点表" />
                        <TextBlock Margin="0,6,0,0"
                                   Foreground="{StaticResource Muted}"
                                   Text="这里显示中位 X 截面上全部 (Y, Z) 点。" />
                    </StackPanel>

                    <DataGrid Grid.Row="1"
                              Margin="0,14,0,0"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              CanUserAddRows="False"
                              HeadersVisibility="Column"
                              ItemsSource="{Binding PointRows}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Width="70"
                                                Header="#"
                                                Binding="{Binding Index}" />
                            <DataGridTextColumn Width="*"
                                                Header="Y"
                                                Binding="{Binding Y, StringFormat=F6}" />
                            <DataGridTextColumn Width="*"
                                                Header="Z"
                                                Binding="{Binding Z, StringFormat=F6}" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>

            <Border Grid.Column="2"
                    Style="{StaticResource CardBorderStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <StackPanel>
                        <TextBlock FontSize="20"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource Ink}"
                                   Text="Y-Z 视图" />
                        <TextBlock Margin="0,6,0,0"
                                   Foreground="{StaticResource Muted}"
                                   Text="按 Y 递增绘制中位 X 截面的代表点，便于快速核对截面形态。" />
                    </StackPanel>

                    <Border Grid.Row="1"
                            x:Name="PlotHost"
                            Margin="0,14,0,0"
                            Background="{StaticResource PlotBackground}"
                            BorderBrush="{StaticResource CardBorder}"
                            BorderThickness="1"
                            CornerRadius="10"
                            SizeChanged="PlotHost_SizeChanged">
                        <Grid>
                            <Canvas x:Name="PlotCanvas"
                                    Margin="14"
                                    ClipToBounds="True">
                                <Line x:Name="XAxis"
                                      Stroke="{StaticResource PlotAxis}"
                                      StrokeThickness="1" />
                                <Line x:Name="YAxis"
                                      Stroke="{StaticResource PlotAxis}"
                                      StrokeThickness="1" />
                                <Polyline Stroke="{StaticResource PlotStroke}"
                                          StrokeThickness="2"
                                          Points="{Binding PlotPoints}" />
                            </Canvas>
                        </Grid>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <Border Grid.Row="3"
                Margin="0,14,0,0"
                Style="{StaticResource CardBorderStyle}">
            <TextBlock Foreground="{StaticResource Muted}"
                       Text="{Binding StatusText}"
                       TextWrapping="Wrap" />
        </Border>
    </Grid>
</Window>
