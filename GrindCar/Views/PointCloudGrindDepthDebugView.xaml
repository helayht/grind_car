<UserControl x:Class="GrindCar.Views.PointCloudGrindDepthDebugView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource PrimaryTextBrush}">
    <UserControl.Resources>

        <Style x:Key="CardBorderStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Padding" Value="18" />
        </Style>

    </UserControl.Resources>

    <ScrollViewer Padding="18" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <Grid MinHeight="560" Height="{Binding ViewportHeight, RelativeSource={RelativeSource AncestorType=ScrollViewer}}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Style="{StaticResource CardBorderStyle}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel>
                    <TextBlock FontSize="24"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource PrimaryTextBrush}"
                               Text="点云算法验证" />
                    <TextBlock Margin="0,6,0,0"
                               Foreground="{DynamicResource MutedTextBrush}"/>
                </StackPanel>

                <WrapPanel Grid.Row="1" Margin="0,8,0,0">
                    <Button Width="130"
                            Margin="0,0,10,6"
                            Content="选择 Left CSV"
                            IsEnabled="{Binding CanSelectFiles}"
                            Click="SelectLeftCsv_Click" />
                    <Button Width="130"
                            Margin="0,0,10,6"
                            Content="选择 Right CSV"
                            IsEnabled="{Binding CanSelectFiles}"
                            Click="SelectRightCsv_Click" />
                    <Button Width="130"
                            Margin="0,0,10,6"
                            Content="计算打磨深度"
                            IsEnabled="{Binding CanCalculate}"
                            Click="Calculate_Click" />
                    <Button Width="150"
                            Margin="0,0,10,6"
                            Content="查看最大掉块廓形"
                            IsEnabled="{Binding CanViewMaximumDropProfile}"
                            Click="ViewMaximumDropProfile_Click" />
                    <Button Width="88"
                            Content="返回首页"
                            Click="Close_Click" />
                </WrapPanel>
            </Grid>
        </Border>

        <Border Grid.Row="1"
                Style="{StaticResource CardBorderStyle}"
                Margin="0,14,0,14">
                <StackPanel>
                    <TextBlock Foreground="{DynamicResource MutedTextBrush}"
                               Text="打磨角度输入" />
                    <TextBox Margin="0,8,0,0"
                             MinHeight="42"
                             AcceptsReturn="True"
                             TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto"
                             VerticalContentAlignment="Top"
                             Foreground="{DynamicResource PrimaryTextBrush}"
                             Background="{DynamicResource InputBackgroundBrush}"
                             BorderBrush="{DynamicResource CardBorderBrush}"
                             IsEnabled="{Binding CanSelectFiles}"
                             Text="{Binding AnglesInput, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>
        </Border>

        <Border Grid.Row="2"
                Style="{StaticResource CardBorderStyle}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <TextBlock FontSize="20"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource PrimaryTextBrush}"
                           Text="需要打磨深度" />

                <DataGrid Grid.Row="1"
                          Margin="0,14,0,0"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          CanUserAddRows="False"
                          HeadersVisibility="Column"
                          Background="{DynamicResource DataGridBackgroundBrush}"
                          Foreground="{DynamicResource PrimaryTextBrush}"
                          BorderBrush="{DynamicResource CardBorderBrush}"
                          ItemsSource="{Binding Results}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Width="*"
                                            Header="角度"
                                            Binding="{Binding Angle}" />
                        <DataGridTextColumn Width="*"
                                            Header="常规深度"
                                            Binding="{Binding RegularDepth, StringFormat=F6}" />
                        <DataGridTextColumn Width="*"
                                            Header="掉块深度"
                                            Binding="{Binding DefectDepth, StringFormat=F6}" />
                        <DataGridTextColumn Width="*"
                                            Header="最终深度"
                                            Binding="{Binding FinalDepth, StringFormat=F6}" />
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>

        <Border Grid.Row="3"
                Margin="0,14,0,0"
                Style="{StaticResource CardBorderStyle}">
            <TextBlock Foreground="{DynamicResource MutedTextBrush}"
                       Text="{Binding StatusMessage}"
                       TextWrapping="Wrap" />
        </Border>
    </Grid>
    </ScrollViewer>
</UserControl>
